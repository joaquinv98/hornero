# Copiar a .env y completar. .env no va al repo.
COMPOSE_PROJECT_NAME=billing

# Receta chica: núcleo, módulos y PostgreSQL en el mismo host.
# En un nodo de alta disponibilidad va solo compose.yaml.
COMPOSE_FILE=compose.yaml:compose.postgres.yaml

# Etiqueta de las imágenes construidas con deploy/Dockerfile. Con el actualizador (D-20), las imágenes salen por digest
# de compose.version.yaml, que escribe él y se suma solo a COMPOSE_FILE: esta etiqueta queda para el primer arranque.
BILLING_VERSION=0.1.0

# Receta chica: puerto de PostgreSQL en 127.0.0.1, por donde llega el actualizador del host. 5432 si no se pone.
# BILLING_PG_PUERTO=5432

# URL pública: la usan la página de retorno y los avisos de las pasarelas.
BILLING_PUBLIC_URL=https://facturacion.example.com

# Dónde publica el rol web. 127.0.0.1 si el proxy está en el mismo host, o la IP del host si está en otro
# (y entonces se filtra en la cadena DOCKER-USER para que solo entre el proxy).
BILLING_HTTP=127.0.0.1:8080

# IP o red CIDR del proxy que termina TLS: el único al que se le cree X-Forwarded-For y X-Forwarded-Proto. Con el
# proxy en el mismo host queda 127.0.0.1. Si hay más de uno (una CDN delante), se suman en compose.yaml como
# ForwardedHeaders__KnownProxies__1, __2 o ForwardedHeaders__KnownNetworks__0.
BILLING_PROXY=127.0.0.1
