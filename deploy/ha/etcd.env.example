# etcd 3.5 o 3.6 de billing-oss, uno por nodo de base (docs/despliegue/ha-vms.md).
# En Debian 13 (paquete etcd-server) va en /etc/default/etcd. En cada nodo cambian ETCD_NAME y las cuatro URL
# con su IP. ETCD_INITIAL_CLUSTER es igual en los tres. Sin comentarios al final de una línea: systemd los toma
# como parte del valor.
# Solo lo usa Patroni para elegir la primaria: no guarda datos de facturación.

ETCD_NAME=billnode01
# En un disco virtual propio (zvol aparte con sync estándar), nunca en el mismo disco que PostgreSQL: un fsync lento
# de la primaria sincrónica le hace perder la llave de líder a etcd y provoca conmutaciones falsas. La métrica
# etcd_disk_wal_fsync_duration_seconds va al monitoreo con alerta.
ETCD_DATA_DIR=/var/lib/etcd/billing
ETCD_LISTEN_PEER_URLS=https://192.0.2.11:2380
ETCD_LISTEN_CLIENT_URLS=https://192.0.2.11:2379,https://127.0.0.1:2379
ETCD_INITIAL_ADVERTISE_PEER_URLS=https://192.0.2.11:2380
ETCD_ADVERTISE_CLIENT_URLS=https://192.0.2.11:2379
ETCD_INITIAL_CLUSTER=billnode01=https://192.0.2.11:2380,billnode02=https://192.0.2.12:2380,billnode03=https://192.0.2.13:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=billing-oss

# TLS mutuo entre miembros y con los clientes (Patroni). Mismo certificado del nodo que PostgreSQL y Patroni.
ETCD_CLIENT_CERT_AUTH=true
ETCD_TRUSTED_CA_FILE=/etc/billing-ha/tls/ca.crt
ETCD_CERT_FILE=/etc/billing-ha/tls/nodo.crt
ETCD_KEY_FILE=/etc/billing-ha/tls/nodo.key
ETCD_PEER_CLIENT_CERT_AUTH=true
ETCD_PEER_TRUSTED_CA_FILE=/etc/billing-ha/tls/ca.crt
ETCD_PEER_CERT_FILE=/etc/billing-ha/tls/nodo.crt
ETCD_PEER_KEY_FILE=/etc/billing-ha/tls/nodo.key

# En VMs, el disco compartido con PostgreSQL puede tardar en el fsync. Con estos tiempos, una demora corta no
# dispara una elección de etcd. Patroni usa ttl 30, así que no cambia el tiempo de conmutación.
ETCD_HEARTBEAT_INTERVAL=250
ETCD_ELECTION_TIMEOUT=2500
ETCD_AUTO_COMPACTION_MODE=periodic
ETCD_AUTO_COMPACTION_RETENTION=1h
