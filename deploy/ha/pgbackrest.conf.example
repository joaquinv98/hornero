# pgBackRest 2.60 o posterior de billing-oss, igual en los tres nodos de base (docs/despliegue/backups.md).
# Va en /etc/pgbackrest/pgbackrest.conf. Las claves de cifrado y las credenciales de S3 no van acá: llegan por
# variables de entorno desde /etc/billing-ha/secretos.env. CAMBIAR los destinos de los repositorios.

[global]
# repo1: en el sitio, en un host que no es nodo de base, por SFTP.
repo1-type=sftp
repo1-sftp-host=192.0.2.20
repo1-sftp-host-user=pgbackrest
repo1-sftp-private-key-file=/var/lib/postgresql/.ssh/pgbackrest_ed25519
repo1-sftp-host-key-hash-type=sha256
repo1-sftp-host-fingerprint=CAMBIAR
repo1-path=/billing-oss
repo1-cipher-type=aes-256-cbc
repo1-retention-full=5

# repo2: fuera del sitio, en un almacenamiento compatible con S3. Obligatorio para producción.
repo2-type=s3
repo2-s3-endpoint=s3.example.com
repo2-s3-bucket=CAMBIAR
repo2-s3-region=CAMBIAR
repo2-path=/billing-oss
repo2-cipher-type=aes-256-cbc
repo2-retention-full=8

archive-async=y
spool-path=/var/spool/pgbackrest
compress-type=zst
process-max=2
start-fast=y
log-level-console=info
log-level-file=detail

[global:archive-push]
process-max=2

[billing]
pg1-path=/var/lib/postgresql/18/billing
pg1-socket-path=/var/run/postgresql
pg1-port=5432
