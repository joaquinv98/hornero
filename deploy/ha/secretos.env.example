# /etc/billing-ha/secretos.env en cada nodo de base: dueño root, permisos 0600. Se arma desde la bóveda y nunca va
# al repo. Lo cargan las unidades de Patroni y de los respaldos con EnvironmentFile. Los procesos de PostgreSQL que
# lanza Patroni lo heredan, y así archive-push de pgBackRest tiene la clave de los repositorios.

PATRONI_SUPERUSER_PASSWORD=
PATRONI_REPLICATION_PASSWORD=
PATRONI_REWIND_PASSWORD=
PATRONI_RESTAPI_USERNAME=patroni
PATRONI_RESTAPI_PASSWORD=

# Claves de cifrado de cada repositorio de pgBackRest, distintas entre sí.
PGBACKREST_REPO1_CIPHER_PASS=
PGBACKREST_REPO2_CIPHER_PASS=
# Credenciales del almacenamiento S3 de repo2.
PGBACKREST_REPO2_S3_KEY=
PGBACKREST_REPO2_S3_KEY_SECRET=
