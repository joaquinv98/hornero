<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Versión de billing-oss. La canalización de versiones la pisa con la de la etiqueta (-p:Version=X.Y.Z). -->
    <Version>0.1.0</Version>
  </PropertyGroup>
  <PropertyGroup>
    <!--
      Auditoría de paquetes (D-20, paso A1): NuGetAudit revisa también las dependencias transitivas. Un aviso nuevo
      sobre cualquier paquete del grafo no traba el build normal, el de las ramas de versión ni el de Renovate: NU1900 a
      NU1905 quedan como advertencia. El vigía diario restaura con -p:AuditPipeline=true y ahí son error.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors Condition="'$(AuditPipeline)' != 'true'">$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
