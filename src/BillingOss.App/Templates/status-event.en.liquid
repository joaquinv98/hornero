{% if kind == "maintenance" %}{% if event == "cancelled" %}Maintenance cancelled: {{ title }}{% elsif event == "completed" %}Maintenance completed: {{ title }}{% elsif event == "started" %}Maintenance in progress: {{ title }}{% elsif event == "rescheduled" %}Maintenance rescheduled: {{ title }}{% elsif event == "updated" %}Maintenance update: {{ title }}{% else %}Scheduled maintenance: {{ title }}{% endif %}{% elsif event == "resolved" %}Incident resolved: {{ title }}{% elsif event == "opened" %}Network incident: {{ title }}{% else %}Incident update: {{ title }}{% endif %}
<h2 style="margin:0 0 12px;font-size:18px;">{{ title }}</h2>
{% if kind == "maintenance" %}<p>{% if event == "cancelled" %}This maintenance has been cancelled.{% elsif event == "completed" %}The maintenance is complete.{% elsif event == "started" %}The maintenance has started.{% elsif event == "rescheduled" %}The schedule of this maintenance has changed.{% elsif event == "updated" %}There is an update on this maintenance.{% else %}We scheduled a maintenance that may affect your services.{% endif %}</p>
{% if event != "cancelled" %}<p><strong>From:</strong> {{ starts }}<br><strong>Until:</strong> {{ ends }}</p>{% endif %}{% else %}<p>{% if event == "opened" %}We are aware of a problem in the network.{% elsif event == "resolved" %}The problem has been resolved.{% else %}There is an update on the problem.{% endif %} Status: {% if state == "investigating" %}investigating{% elsif state == "identified" %}cause identified{% elsif state == "monitoring" %}monitoring{% else %}resolved{% endif %}.</p>{% endif %}
{% if message %}<p>{{ message }}</p>{% endif %}
{% if components.size > 0 %}<p><strong>{% if kind == "maintenance" %}Affects{% else %}Affected components{% endif %}:</strong></p>
<ul>{% for c in components %}<li>{{ c.name }}{% if kind == "incident" %} ({% if c.impact == "majoroutage" %}major outage{% elsif c.impact == "partialoutage" %}partial outage{% else %}degraded{% endif %}){% endif %}</li>{% endfor %}</ul>{% endif %}
<p><a href="{{ url }}">See the network status</a></p>
<p style="font-size:12px;color:#616e7c;">You receive this notice because you subscribed to the network status. If you no longer want it, <a href="{{ unsubscribe_url }}">unsubscribe this address</a>.</p>
