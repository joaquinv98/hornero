[#{{ number }}] Message from {{ requester }}: {{ subject }}
<p>{{ author }} wrote in ticket #{{ number }} of {{ department }}{% if assigned %}, assigned to you{% endif %}:</p>
<div style="margin:16px 0;padding:12px 16px;background:#f4f5f7;border-radius:6px;white-space:pre-wrap;">{{ message }}</div>
{% if files.size > 0 %}<p>Attachments: {{ files | join: ", " }}</p>{% endif %}
{% if portal_url %}<p><a href="{{ portal_url }}/admin/soporte/{{ ticket_id }}">Open the ticket in the admin panel</a></p>{% endif %}
