{% if kind == "maintenance" %}{% if event == "cancelled" %}Mantenimiento cancelado: {{ title }}{% elsif event == "completed" %}Mantenimiento terminado: {{ title }}{% elsif event == "started" %}Mantenimiento en curso: {{ title }}{% elsif event == "rescheduled" %}Mantenimiento reprogramado: {{ title }}{% elsif event == "updated" %}Novedad sobre el mantenimiento: {{ title }}{% else %}Mantenimiento programado: {{ title }}{% endif %}{% elsif event == "resolved" %}Incidente resuelto: {{ title }}{% elsif event == "opened" %}Incidente en la red: {{ title }}{% else %}Novedad sobre el incidente: {{ title }}{% endif %}
<h2 style="margin:0 0 12px;font-size:18px;">{{ title }}</h2>
{% if kind == "maintenance" %}<p>{% if event == "cancelled" %}Cancelamos este mantenimiento.{% elsif event == "completed" %}El mantenimiento terminó.{% elsif event == "started" %}El mantenimiento empezó.{% elsif event == "rescheduled" %}Cambiamos el horario de este mantenimiento.{% elsif event == "updated" %}Tenemos una novedad sobre este mantenimiento.{% else %}Programamos un mantenimiento que puede afectar tus servicios.{% endif %}</p>
{% if event != "cancelled" %}<p><strong>Desde:</strong> {{ starts }}<br><strong>Hasta:</strong> {{ ends }}</p>{% endif %}{% else %}<p>{% if event == "opened" %}Estamos al tanto de un problema en la red.{% elsif event == "resolved" %}El problema se resolvió.{% else %}Tenemos una novedad sobre el problema.{% endif %} Estado: {% if state == "investigating" %}estamos investigando{% elsif state == "identified" %}identificamos la causa{% elsif state == "monitoring" %}lo estamos monitoreando{% else %}resuelto{% endif %}.</p>{% endif %}
{% if message %}<p>{{ message }}</p>{% endif %}
{% if components.size > 0 %}<p><strong>{% if kind == "maintenance" %}Afecta a{% else %}Componentes afectados{% endif %}:</strong></p>
<ul>{% for c in components %}<li>{{ c.name }}{% if kind == "incident" %} ({% if c.impact == "majoroutage" %}interrupción total{% elsif c.impact == "partialoutage" %}interrupción parcial{% else %}degradado{% endif %}){% endif %}</li>{% endfor %}</ul>{% endif %}
<p><a href="{{ url }}">Ver el estado de la red</a></p>
<p style="font-size:12px;color:#616e7c;">Recibís este aviso porque te suscribiste al estado de la red. Si ya no lo querés, <a href="{{ unsubscribe_url }}">dá de baja esta casilla</a>.</p>
