[#{{ number }}] {{ subject }}
<p style="margin:0 0 16px;font-size:12px;color:#616e7c;">{{ reply_marker }}</p>
<p>Hi {{ requester }},</p>
<p>{% if staff_opened %}{{ author }} opened request #{{ number }} for you:{% else %}{{ author }} replied to your request #{{ number }}:{% endif %}</p>
<div style="margin:16px 0;padding:12px 16px;background:#f4f5f7;border-radius:6px;white-space:pre-wrap;">{{ message }}</div>
{% if files.size > 0 %}<p>Attachments: {{ files | join: ", " }}.{% if has_account and portal_url %} You can download them from <a href="{{ portal_url }}/soporte/{{ ticket_id }}">your account</a>.{% endif %}</p>{% endif %}
<p>To continue, just reply to this email.</p>
