[#{{ number }}] {{ subject }}
<p style="margin:0 0 16px;font-size:12px;color:#616e7c;">{{ reply_marker }}</p>
<p>Hola, {{ requester }}:</p>
<p>{% if staff_opened %}{{ author }} abrió la consulta N.º {{ number }} para vos:{% else %}{{ author }} respondió tu consulta N.º {{ number }}:{% endif %}</p>
<div style="margin:16px 0;padding:12px 16px;background:#f4f5f7;border-radius:6px;white-space:pre-wrap;">{{ message }}</div>
{% if files.size > 0 %}<p>Adjuntos: {{ files | join: ", " }}.{% if has_account and portal_url %} Los podés bajar desde <a href="{{ portal_url }}/soporte/{{ ticket_id }}">tu cuenta</a>.{% endif %}</p>{% endif %}
<p>Para seguir, respondé este correo.</p>
