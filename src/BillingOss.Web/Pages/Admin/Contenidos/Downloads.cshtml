@page "/admin/descargas"
@model DownloadsModel
@{
    ViewData["Title"] = C["Cms.Downloads"];
    var withoutFile = new Pill("warn", "ring", C["Cms.WithoutFile"]);
}
<h1>@C["Cms.Downloads"]</h1>
<partial name="_Tabs" />
<partial name="_Alerts" model="Model" />
@if (Model.CanWrite)
{
    <p class="ct-actions">
        <a class="button" href="/admin/descargas/nueva">@C["Cms.NewDownload"]</a>
        <a class="button secondary" href="/admin/descargas/categorias">@C["Cms.NewCategory"]</a>
    </p>
}
<form method="get" class="ct-filters" role="search" aria-label="@C["Cms.Filters"]">
    <div>
        <label for="f-cat">@C["Cms.Category"]</label>
        <select id="f-cat" name="category">
            <option value="">@C["Cms.All"]</option>
            @foreach (var c in Model.CategoryChoices)
            {
                <option value="@c.Id" selected="@(Model.Category == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div>
        <label for="f-state">@C["Cms.State"]</label>
        <select id="f-state" name="state">
            <option value="">@C["Cms.All"]</option>
            <option value="Draft" selected="@(Model.State == "Draft")">@C["Cms.StateDraft"]</option>
            <option value="Published" selected="@(Model.State == "Published")">@C["Cms.StatePublished"]</option>
            <option value="Archived" selected="@(Model.State == "Archived")">@C["Cms.StateArchived"]</option>
        </select>
    </div>
    <button type="submit">@C["Cms.Filter"]</button>
</form>
@if (Model.Rows.Count == 0)
{
    <p>@C["Cms.NoDownloads"]</p>
}
else
{
    <div class="table">
        <table>
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@C["Cms.Title"]</th>
                    <th scope="col">@C["Cms.Category"]</th>
                    <th scope="col">@C["Cms.State"]</th>
                    <th scope="col">@C["Cms.AudienceWho"]</th>
                    <th scope="col">@C["Cms.File"]</th>
                    <th scope="col" class="num">@C["Cms.Downloaded"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Download.Id</td>
                        <td>
                            @if (Model.CanWrite)
                            {
                                <a href="/admin/descargas/@r.Download.Id">@Model.TitleOf(r)</a>
                            }
                            else
                            {
                                @Model.TitleOf(r)
                            }
                        </td>
                        <td>@Model.CategoryName(r.Download.CategoryId)</td>
                        <td><partial name="_Pill" model="ContentUi.PublishPill(r.Download.Status, C)" /></td>
                        <td>@Model.AudienceName(r.Download.Audience)</td>
                        <td>
                            @if (r.Download.HasFile)
                            {
                                @r.Download.FileName <span class="muted">(@ContentUi.Size(r.Download.Size!.Value))</span>
                            }
                            else
                            {
                                <partial name="_Pill" model="withoutFile" />
                            }
                        </td>
                        <td class="num">@r.Download.DownloadCount.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<h2 id="categories">@C["Cms.Categories"]</h2>
@if (Model.Categories.Count == 0)
{
    <p>@C["Cms.NoCategories"]</p>
}
else
{
    <div class="table">
        <table aria-labelledby="categories">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@C["Cms.Name"]</th>
                    <th scope="col">@C["Cms.Slug"]</th>
                    <th scope="col" class="num">@C["Cms.Downloads"]</th>
                    <th scope="col">@C["Cms.Visibility"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr>
                        <td>@c.Category.Id</td>
                        <td>
                            @if (Model.CanWrite)
                            {
                                <a href="/admin/descargas/categorias/@c.Category.Id">@Model.CategoryName(c.Category.Id)</a>
                            }
                            else
                            {
                                @Model.CategoryName(c.Category.Id)
                            }
                        </td>
                        <td><code>@c.Category.Slug</code></td>
                        <td class="num">@c.Items</td>
                        <td>@(c.Category.Hidden ? C["Cms.Hidden"] : C["Cms.Visible"])</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
