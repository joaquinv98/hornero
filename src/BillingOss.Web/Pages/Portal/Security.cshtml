@page "/cuenta/seguridad"
@model SecurityModel
@{
    ViewData["Title"] = L["Security.Title"];
}
<h1>@L["Security.Title"]</h1>
@if (Model.Error is not null)
{
    <div class="alert" role="alert">
        <p>@UiText.Get(L, S, Model.Error)</p>
        <partial name="_PasswordProblems" model="Model.Problems" />
    </div>
}
@if (Model.Notice is not null)
{
    <p class="notice" role="status">@S[Model.Notice]</p>
}

<section aria-labelledby="email">
    <h2 id="email">@S["Mail.Title"]</h2>
    <p>
        @Model.Email
        @if (Model.EmailConfirmed)
        {
            <span class="status" data-tone="ok">@S["Mail.IsVerified"]</span>
        }
        else
        {
            <span class="status" data-tone="warn" data-shape="ring">@S["Mail.NotVerified"]</span>
        }
    </p>
    @if (!Model.EmailConfirmed)
    {
        <form method="post" asp-page-handler="Verify">
            <button type="submit" class="secondary">@S["Mail.Send"]</button>
        </form>
    }
</section>

<section aria-labelledby="second-factor">
    <h2 id="second-factor">@S["TwoFa.Title"]</h2>
    @if (Model.RecoveryCodes is { } codes)
    {
        <p class="notice" role="status">@L["Security.Enabled"]</p>
        <partial name="_RecoveryCodes" model="codes" />
    }
    else if (Model.Enabled)
    {
        <p>@L["Security.IsOn"]</p>
        <p class="@(Model.CodesLeft <= SecurityModel.FewCodes ? "alert" : "muted")">@S["TwoFa.CodesLeft", Model.CodesLeft]</p>
        <form method="post" asp-page-handler="Codes" class="stack narrow">
            <label for="codes-code">@L["Field.Code"]</label>
            <input id="codes-code" name="Code" inputmode="numeric" autocomplete="one-time-code" required>
            <button type="submit" class="secondary">@S["TwoFa.NewCodes"]</button>
        </form>
        @if (Model.Required)
        {
            <p>@(Model.Imported ? L["Security.CannotDisable"] : S["TwoFa.CannotDisable"])</p>
        }
        else
        {
            <form method="post" asp-page-handler="Disable" class="stack narrow">
                <label for="code">@L["Field.Code"]</label>
                <input id="code" name="Code" inputmode="numeric" autocomplete="one-time-code" required>
                <button type="submit" class="secondary">@L["Security.Disable"]</button>
            </form>
        }
    }
    else
    {
        @if (Model.Required)
        {
            <p class="notice" role="status">@(Model.Imported ? L["Security.Required"] : S["TwoFa.Required"])</p>
        }
        <p>@L["Security.IsOff"]</p>
        <partial name="_TotpSetup" model="Model.Setup" />
        <form method="post" asp-page-handler="Enable" class="stack narrow">
            <label for="code">@L["Field.Code"]</label>
            <input id="code" name="Code" inputmode="numeric" autocomplete="one-time-code" required>
            <button type="submit">@L["Security.Enable"]</button>
        </form>
    }
</section>

<section aria-labelledby="password">
    <h2 id="password">@S["Pwd.Title"]</h2>
    @if (!Model.HasPassword)
    {
        <p>@S["External.NoPassword"] <a href="/recuperar">@L["Login.Forgot"]</a></p>
    }
    else
    {
    <p class="muted" id="password-rules">@S["Pwd.Hint", Model.MinLength]</p>
    <form method="post" asp-page-handler="Password" class="stack narrow">
        <label for="current">@S["Pwd.Current"]</label>
        <input id="current" name="CurrentPassword" type="password" autocomplete="current-password" required>
        <label for="new">@L["Field.NewPassword"]</label>
        <input id="new" name="NewPassword" type="password" autocomplete="new-password" minlength="@Model.MinLength" maxlength="128" aria-describedby="password-rules" required>
        <label for="confirm">@L["Field.ConfirmPassword"]</label>
        <input id="confirm" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="@Model.MinLength" maxlength="128" required>
        <button type="submit" class="secondary">@S["Pwd.Change"]</button>
    </form>
    }
</section>

<section aria-labelledby="external">
    <h2 id="external">@S["External.Section"]</h2>
    @if (Model.Links.Count == 0)
    {
        <p class="muted">@S["External.NoLinks"]</p>
    }
    else
    {
        <div class="table"><table>
            <thead><tr><th scope="col">@S["External.Provider"]</th><th scope="col">@L["Field.Email"]</th><th scope="col">@S["External.LinkedAt"]</th><th scope="col"></th></tr></thead>
            <tbody>
                @foreach (var (link, provider) in Model.Links)
                {
                    <tr>
                        <td>@provider</td>
                        <td>@link.Email</td>
                        <td><time datetime="@link.CreatedAt.ToString("O", CultureInfo.InvariantCulture)">@UiText.When(link.CreatedAt, Model.TimeZone)</time></td>
                        <td>
                            <form method="post" asp-page-handler="Unlink" asp-route-id="@link.Id" class="inline">
                                <button type="submit" class="link">@S["External.Unlink"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
    @foreach (var provider in Model.Providers)
    {
        <form method="post" asp-page-handler="Link">
            <input type="hidden" name="provider" value="@provider.Key">
            <button type="submit" class="secondary">@S["External.LinkWith", provider.Name]</button>
        </form>
    }
</section>

<section aria-labelledby="logins">
    <h2 id="logins">@S["History.Title"]</h2>
    <partial name="_LoginHistory" model="Model.Logins" />
</section>
