@model IReadOnlyList<string>
<section class="notice" aria-labelledby="recovery">
    <h2 id="recovery">@L["Totp.RecoveryTitle"]</h2>
    <p>@L["Totp.RecoveryHelp"]</p>
    <ul class="codes">
        @foreach (var code in Model)
        {
            <li><code>@code</code></li>
        }
    </ul>
</section>
